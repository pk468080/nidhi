{
  "rules": {
    "tracking": {
      "$bookingId": {
        ".read": "auth != null && (data.child('userId').val() == auth.uid || data.child('providerId').val() == auth.uid)",
        ".write": "auth != null && (data.child('userId').val() == auth.uid || data.child('providerId').val() == auth.uid || newData.child('userId').val() == auth.uid || newData.child('providerId').val() == auth.uid)",
        "userId": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())"
        },
        "providerId": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())"
        },
        "providerLat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "providerLng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "eta": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}

