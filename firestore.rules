rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProvider() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "provider";
    }

    function isAssignedProvider(providerId) {
      return isSignedIn() && providerId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isAssignedProvider(resource.data.providerId) || isProvider();

      // Customer can only update their own address/notes/schedule while booking is still pending.
      allow update: if isOwner(resource.data.userId)
        && resource.data.status == "pending"
        && request.resource.data.providerId == resource.data.providerId;

      // Provider-side lifecycle updates.
      allow update: if isProvider() || isAssignedProvider(resource.data.providerId);
    }

    match /payments/{paymentId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isProvider());
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isProvider();
      allow create, update: if isOwner(userId);

      match /devices/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Providers are publicly readable; only the provider themselves can write.
    match /providers/{providerId} {
      allow read: if true;
      allow create, update: if isOwner(providerId);
      allow delete: if false;
    }

    // Services are publicly readable; only the owning provider can write.
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.providerId == request.auth.uid;
    }

    // Reviews: readable by customer and provider involved; created only by the customer.
    match /reviews/{reviewId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.providerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    // In-app notifications: each user reads and manages their own.
    match /notifications/{userId}/messages/{notificationId} {
      allow read, write: if isOwner(userId);
    }
  }
}

